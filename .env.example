# Optional. DeepSeek is preferred when configured. When absent, MarginMind falls back to OpenAI or local rules.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

OPENAI_API_KEY=
OPENAI_MODEL=

# Gaze defaults. These can also be changed from the UI request payload.
MARGINMIND_SAMPLE_HZ=24
